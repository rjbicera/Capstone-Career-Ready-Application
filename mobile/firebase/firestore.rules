rules_version = '2';

// SECURITY POSTURE: deny direct client reads AND writes on every collection.
//
// Why deny reads too, not just writes (the SDD only explicitly requires
// denying writes)? Two reasons specific to this app:
//   1. assessment_questions contains correctAnswerIndex. If clients could
//      read assessments directly, students could read exam answers straight
//      out of Firestore via any REST/JS client, bypassing your app entirely.
//   2. Every read in this app already needs a Firebase ID token verified
//      AND business logic applied (e.g. "only return MY resume feedback,
//      never someone else's" — the backend already does uid scoping in
//      queries). Duplicating that logic in rules is more attack surface to
//      get wrong, not less. One enforcement point (the Express API) is
//      easier to audit and defend in your security review.
//
// Trade-off you're accepting: one extra network hop for every read,
// vs. a mobile app that could talk to Firestore directly. For a capstone
// with AI-mediated responses (you're already hitting the backend to get
// AI feedback anyway), this costs nothing in practice.

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
