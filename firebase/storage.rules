rules_version = '2';

// Profile photos are the one thing the mobile app uploads DIRECTLY to
// Firebase rather than through the Express API, so unlike Firestore
// (which denies all client access — see firestore.rules) this bucket
// needs real per-user rules.
//
// Why direct-to-Storage instead of routing through the backend: the
// API would otherwise have to accept multipart uploads, buffer several
// MB of image data per request, and re-upload it — for no security
// gain, since the rules below already scope writes to the owner.

service firebase.storage {
  match /b/{bucket}/o {

    // profile_photos/{uid}.jpg
    //
    // Keyed by UID so a user can only ever touch their own file, and
    // so re-uploading overwrites the old photo instead of accumulating
    // orphaned images in the bucket.
    match /profile_photos/{fileName} {

      // Any signed-in user can read profile photos. They're avatars
      // shown in-app, not private documents.
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   // Only your own file.
                   && fileName == request.auth.uid + '.jpg'
                   // Images only — stops the bucket being used as
                   // general file storage.
                   && request.resource.contentType.matches('image/.*')
                   // 5 MB ceiling. The app already downscales to
                   // 800x800 at 85% quality before upload, so this is
                   // just a backstop against a modified client.
                   && request.resource.size < 5 * 1024 * 1024;

      allow delete: if request.auth != null
                    && fileName == request.auth.uid + '.jpg';
    }

    // Everything else stays closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
